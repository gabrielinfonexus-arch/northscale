{
  "name": "northscale",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "tsx scripts/deploy-setup.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --trace off",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed/index.ts && tsx scripts/ensure-owner.ts && npm run watchdog",
    "db:refresh-views": "tsx scripts/refresh-views.ts",
    "postinstall": "prisma generate",
    "client:create": "tsx scripts/create-client.ts",
    "watchdog": "tsx --conditions=react-server scripts/watchdog-run.ts",
    "owner:ensure": "tsx scripts/ensure-owner.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "inngest": "^4.26.2",
    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "react-grid-layout": "^2.3.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "prisma": "^7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
