# ─── Database (Supabase Postgres) ───────────────────────────────────────────
# Local:    postgresql://postgres:postgres@localhost:5432/northscale?schema=public
# Supabase: Project → Settings → Database → Connection string (use the pooled URL on Vercel)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/northscale?schema=public"

# ─── Security ───────────────────────────────────────────────────────────────
# 32-byte key for AES-256-GCM encryption of every platform token at rest.
# Generate with:  openssl rand -hex 32
ENCRYPTION_KEY=""

# ─── Demo data ──────────────────────────────────────────────────────────────
# Days of demo history generated by `npm run db:seed` (default 180)
SEED_DAYS=180

# ─── Filled in later phases (listed now so the full set is in one place) ────
# Public URL of the app (used for OAuth redirect URIs). Defaults to the request origin.
APP_URL="http://localhost:3000"

# ─── Phase 3 — Meta Marketing API ───────────────────────────────────────────
META_APP_ID=""
META_APP_SECRET=""
META_LOGIN_CONFIG_ID=""          # Facebook Login for Business configuration id (recommended)
META_API_VERSION="v26.0"         # Marketing API calls to an expired version FAIL — keep current
META_MOCK=""                     # "1" = simulated Graph API for local dev / tests (refused in production)

# ─── Phase 3 — job queue (Inngest) ──────────────────────────────────────────
# Without these, jobs run in-process (local dev). On Vercel, install the Inngest integration.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""
INNGEST_DEV=""                   # "1" to use a local `npx inngest-cli dev` server
# ─── Phase 4 — Google Ads API ───────────────────────────────────────────────
GOOGLE_ADS_DEVELOPER_TOKEN=""    # API Center of your manager (MCC) account
GOOGLE_ADS_CLIENT_ID=""          # Google Cloud OAuth client (Web application)
GOOGLE_ADS_CLIENT_SECRET=""
GOOGLE_ADS_API_VERSION="v26"     # requests to a sunset version fail — keep current
GOOGLE_ADS_DAILY_OPERATIONS="15000"  # Basic access quota, used for the usage % on Sync Overview
GOOGLE_ADS_MOCK=""               # "1" = simulated Google Ads API for local dev / tests
# ─── Phase 5 — Shopify Admin API ────────────────────────────────────────────
SHOPIFY_API_VERSION="2026-10"
SHOPIFY_API_KEY=""               # only for "Install via OAuth" (app distributed to other stores)
SHOPIFY_API_SECRET=""            # same app; also verifies its webhooks
SHOPIFY_WEBHOOK_SECRET=""        # legacy custom apps: the "API secret key" that signs webhooks
SHOPIFY_MOCK=""                  # "1" = simulated Shopify API for local dev / tests
# Sign-in: the first Owner (set on every deploy / `npm run owner:ensure`; local default password "northscale-dev")
OWNER_EMAIL=""
OWNER_PASSWORD=""                # ≥ 10 characters; applied only while the Owner has no password (or OWNER_PASSWORD_RESET=1)
# Optional extra gate: an HTTP Basic password in front of everything (e.g. a staging URL)
SITE_PASSWORD=""
SITE_USER=""                     # optional; empty = any user name
SEED_DEMO_ON_DEPLOY=""           # "0" = don't create demo clients on the first deploy
# Phase 6 — Watchdog notifications (the Slack webhook is set in the app, stored encrypted)
RESEND_API_KEY=""                # emails via Resend: Watchdog alerts, invitations, password resets (optional)
ALERT_EMAIL_FROM=""              # e.g. "NorthScale <alerts@yourdomain.com>" (a domain verified in Resend)
# Phase 7 — AI
ANTHROPIC_API_KEY=""             # Hive-Mind + AI Insights (server-side only; never sent to the browser)
ANTHROPIC_MODEL="claude-sonnet-5-5"        # everyday questions and insights
ANTHROPIC_MODEL_HEAVY="claude-opus-5-5"    # "Deep analysis" conversations
AI_MOCK=""                       # "1" = scripted model for local dev / tests (refused in production)

