# ─── Database (Supabase Postgres) ───────────────────────────────────────────
# Local:    postgresql://postgres:postgres@localhost:5432/northscale?schema=public
# Supabase: Project → Settings → Database → Connection string (use the pooled URL on Vercel)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/northscale?schema=public"

# ─── Security ───────────────────────────────────────────────────────────────
# 32-byte key for AES-256-GCM encryption of every platform token at rest.
# Generate with:  openssl rand -hex 32
ENCRYPTION_KEY=""

# ─── Demo data ──────────────────────────────────────────────────────────────
# Days of demo history generated by `npm run db:seed` (default 180)
SEED_DAYS=180

# ─── Filled in later phases (listed now so the full set is in one place) ────
# Phase 3 — Meta Marketing API
META_APP_ID=""
META_APP_SECRET=""
META_SYSTEM_USER_TOKEN=""        # optional: System User token instead of OAuth
# Phase 3 — job queue (Inngest)
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""
# Phase 4 — Google Ads API
GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ADS_CLIENT_ID=""
GOOGLE_ADS_CLIENT_SECRET=""
GOOGLE_ADS_LOGIN_CUSTOMER_ID=""  # MCC id without dashes (optional)
# Phase 5 — Shopify Admin API
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
SHOPIFY_WEBHOOK_SECRET=""
# Phase 6 — notifications
SLACK_WEBHOOK_URL=""
RESEND_API_KEY=""
# Phase 7 — AI
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"
ANTHROPIC_MODEL_HEAVY="claude-opus-5-5"
# Phase 8 — auth (Supabase)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
